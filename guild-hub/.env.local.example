# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API (or "Connect" → App Frameworks).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Battle.net gear sync (see README). Leave out to just use the addon.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=
# BLIZZARD_REGION=eu
# BLIZZARD_NAMESPACE=profile-classic1x
